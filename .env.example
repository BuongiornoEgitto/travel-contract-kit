# Optional: `npm run dev` prints a link to a guided setup page that writes
# .env.local for you. Copy this file only if you prefer to configure by hand.
# The agency supplies and pays for its own services.
# Replace with credentials for your own PostgreSQL database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AGENCY_NAME=Agenzia Viaggi
CONTRACT_TEMPLATE_TEXT=Riepilogo del viaggio e condizioni definite dall’agenzia.
S3_ENDPOINT=
S3_BUCKET=contratti
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
APP_URL=http://localhost:3000
# At least 12 characters. The app refuses to start with the sample value.
OPERATOR_PASSWORD=change-this-before-public-use
